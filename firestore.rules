rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────────
    // GLOBAL HELPERS
    // ─────────────────────────────────────────────────────────────────────────
    
    function isSignedIn() {
      return request.auth != null;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // RULES
    // ─────────────────────────────────────────────────────────────────────────

    // Users collection: Full read & write for username authentication and admin user management
    match /users/{userId} {
      allow read, write: if true;
    }

    // Usernames mapping: Unique username reservation & lookup
    match /usernames/{usernameId} {
      allow read, write: if true;
    }

    // Settings collection
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Subjects collection
    match /subjects/{subjectId} {
      allow read, write: if true;
    }

    // Questions bank: Read & write for exam builder and question management
    match /questions/{questionId} {
      allow read, write: if true;
      
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Question imports session
    match /questionImports/{importId} {
      allow read, write: if true;
      
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Exams collection: Read & write for exams catalog and student CBT
    match /exams/{examId} {
      allow read, write: if true;
      
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Attempts collection: CBT live session records and answers
    match /attempts/{attemptId} {
      allow read, write: if true;
      
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Results collection
    match /results/{resultId} {
      allow read, write: if true;
      
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Training Materials (Modul Materi)
    match /materials/{materialId} {
      allow read, write: if true;
      
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Attempt Results & Per-Question Results
    match /attemptResults/{attemptId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
